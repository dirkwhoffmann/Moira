# Doxyfile for the VirtualC64 public API reference
#
# Only the XML output is used; "make" turns it into the VitePress site (see
# Makefile). Only the headers that make up the public API are listed in INPUT.
# Everything below them (components, internals) is deliberately left out.

PROJECT_NAME           = "Moira"
PROJECT_NUMBER         = "v5.0 beta"
PROJECT_BRIEF          = "Motorola 68k CPU emulator"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
TAB_SIZE               = 4

# What to extract
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_SCOPE_NAMES       = YES
SORT_MEMBER_DOCS       = NO
SHOW_INCLUDE_FILES     = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= NO

# Diagnostics
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"

# Input
INPUT                  = ../Moira/Moira.h \
                         ../Moira/MoiraTypes.h \
                         ../Moira/MoiraDebugger.h
FILE_PATTERNS          = *.h
RECURSIVE              = NO

# The headers use C++20; the macros below only matter for a few attributes
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = "__cplusplus=202002L" \
                         MOIRA_NAMESPACE=moira \
                         MOIRA_VIRTUAL_API=1

# HTML output is not needed
GENERATE_HTML          = NO

# Other output formats
GENERATE_LATEX         = NO

# XML output (input for moxygen)
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
STRIP_FROM_PATH        = ../Moira
STRIP_FROM_INC_PATH    = ../Moira

# Diagrams
HAVE_DOT               = NO
EXCLUDE_SYMBOLS        = moira::Flag moira::Flag::* moira::AV moira::AV::* moira::SSW030 moira::SSW040 moira::SSW030::* moira::SSW040::*
DOT_IMAGE_FORMAT       = svg
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
GENERATE_LEGEND        = NO
HIDE_UNDOC_RELATIONS   = YES
