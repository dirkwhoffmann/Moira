import { defineConfig } from 'vitepress'
import { readdirSync, readFileSync } from 'node:fs'
import { join } from 'node:path'

// The API pages are generated by moxygen and fix_markdown.py (api/); the guides
// (guides/) are plain Markdown. Each section has its own sidebar, built from
// the files and their first heading.
const docs = join(__dirname, '..')
const apiDir = join(docs, 'api')

// Color schemes. The scheme is selected at build time, e.g. "make SCHEME=nord".
// index.ts imports its stylesheet through the alias "@scheme"; the code blocks
// use the matching syntax highlighting themes.
const schemes: Record<string, { css: string, code: { light: string, dark: string } }> = {
  catppuccin: {
    css: join(docs, '..', 'node_modules/@catppuccin/vitepress/theme/mocha/mauve.css'),
    code: { light: 'catppuccin-latte', dark: 'catppuccin-mocha' },
  },
  dracula: {
    css: join(__dirname, 'theme/schemes/dracula.css'),
    code: { light: 'github-light', dark: 'dracula' },
  },
  nord: {
    css: join(__dirname, 'theme/schemes/nord.css'),
    code: { light: 'github-light', dark: 'nord' },
  },
  'tokyo-night': {
    css: join(__dirname, 'theme/schemes/tokyo-night.css'),
    code: { light: 'github-light', dark: 'tokyo-night' },
  },
}
const schemeName = process.env.SCHEME || 'tokyo-night'
const scheme = schemes[schemeName]
if (!scheme) {
  throw new Error(`Unknown SCHEME '${schemeName}'. Choose one of: ${Object.keys(schemes).join(', ')}`)
}

// The guides, grouped like the manual: [group, [folder, [pages]]]
const guideGroups: [string, string, string[]][] = [
  ['Overview', 'overview', ['About']],
  ['Tutorials', 'tutorials', ['GettingStarted', 'UsingMoiraInYourOwnApp']],
  ['How-to guides', 'howto', ['HowToUseTheCpu', 'HowToUseTheDisassembler', 'HowToUseTheDebugger',
                              'HowToUseDelegates', 'HowToOverclockTheCpu']],
  ['Expert notes', 'notes', ['MainExecutionFunction', 'InstructionHandlers']],
  ['References', 'reference', ['ConfigOptions']],
]

function title(folder: string, page: string): string {
  const text = readFileSync(join(docs, 'guides', folder, `${page}.md`), 'utf8')
  return /^# (.+?)\s*$/m.exec(text)?.[1] ?? page
}

function guideSidebar() {
  return guideGroups.map(([text, folder, pages]) => ({
    text,
    collapsed: false,
    items: pages.map(p => ({ text: title(folder, p), link: `/guides/${folder}/${p}` })),
  }))
}

function apiFiles(): string[] {
  return readdirSync(apiDir).filter(f => f.endsWith('.md'))
}

function kindOf(file: string): string {
  return /^kind:\s*(\w+)\s*$/m.exec(readFileSync(join(apiDir, file), 'utf8'))?.[1] ?? ''
}

// The classes in the order of the API overview
const classes = ['Moira', 'Debugger', 'Guards', 'Breakpoints', 'Watchpoints', 'Catchpoints',
                 'SoftwareTraps', 'SoftwareTrap', 'Guard']

// Structs, grouped by what they are for. The first matching rule decides.
const structKinds: [string, RegExp][] = [
  ['CPU state', /^(Registers|StatusRegister|PrefetchQueue|StackFrame|CycleBudget)$/],
  ['Disassembler', /^(InstrInfo|DasmStyle|DasmNumberFormat)$/],
  ['Exceptions', /^(IllegalInstruction|DoubleFault|AddressError|BusError)$/],
  ['Other', /./],
]

function apiClasses() {
  const present = apiFiles().filter(f => f.startsWith('moira-')).map(f => f.replace(/^moira-|\.md$/g, ''))
  const kind = (c: string) => kindOf(`moira-${c}.md`)
  const list = present.filter(c => kind(c) === 'class' || classes.includes(c))
  const rank = (c: string) => { const i = classes.indexOf(c); return i < 0 ? classes.length : i }
  return list.sort((a, b) => rank(a) - rank(b) || a.localeCompare(b))
    .map(c => ({ text: c, link: `/api/moira-${c}` }))
}

function structGroups() {
  const structs = apiFiles().filter(f => f.startsWith('moira-') && /^(struct|union)$/.test(kindOf(f)))
    .map(f => f.replace(/^moira-|\.md$/g, ''))
    .filter(c => !classes.includes(c))
    .sort((a, b) => a.localeCompare(b))
  const groups = new Map(structKinds.map(([label]) => [label, [] as string[]]))
  for (const c of structs) groups.get(structKinds.find(([, re]) => re.test(c))![0])!.push(c)
  return [...groups].filter(([, list]) => list.length)
    .map(([label, list]) => ({
      text: label,
      collapsed: true,
      items: list.map(c => ({ text: c, link: `/api/moira-${c}` })),
    }))
}

function enumItems() {
  return apiFiles().filter(f => f.startsWith('enum-'))
    .map(f => f.replace(/^enum-|\.md$/g, ''))
    .sort((a, b) => a.localeCompare(b))
    .map(e => ({ text: e, link: `/api/enum-${e}` }))
}

// Namespaces with flags and constants
function namespaceItems() {
  return apiFiles().filter(f => f.startsWith('moira-') && kindOf(f) === 'namespace')
    .map(f => f.replace(/^moira-|\.md$/g, ''))
    .sort((a, b) => a.localeCompare(b))
    .map(n => ({ text: n, link: `/api/moira-${n}` }))
}

export default defineConfig({
  title: 'Moira',
  description: 'A Motorola 68k CPU emulator',
  lang: 'en-US',
  // The published site lives in a subfolder (see "make publish")
  base: process.env.BASE || '/',
  cleanUrls: true,
  outDir: '../build/site',
  markdown: { theme: scheme.code },
  vite: { resolve: { alias: { '@scheme': scheme.css } } },
  themeConfig: {
    logo: '/icon.png',
    search: { provider: 'local' },
    nav: [
      { text: 'Guides', link: '/guides/overview/About', activeMatch: '^/guides/' },
      { text: 'API', link: '/api/overview', activeMatch: '^/api/' },
    ],
    sidebar: {
      '/guides/': guideSidebar(),
      '/api/': [
        { text: 'API', collapsed: false, items: [{ text: 'Overview', link: '/api/overview' }, ...apiClasses()] },
        { text: 'Structs', collapsed: true, items: structGroups() },
        { text: 'Enumerations', collapsed: true, items: enumItems() },
        { text: 'More', collapsed: false, items: [
          { text: 'Types and Enumerations', link: '/api/moira' },
          ...namespaceItems(),
        ] },
      ],
    },
  },
})
